<workout_file>
    <author>trainer</author>
    <name>Short Test</name>
    <description>2 minute hardware smoke test: ramp, intervals, free ride.</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="30" PowerLow="0.40" PowerHigh="0.60"/>
        <IntervalsT Repeat="2" OnDuration="15" OffDuration="15" OnPower="0.80" OffPower="0.50"/>
        <SteadyState Duration="15" Power="0.70"/>
        <FreeRide Duration="15"/>
    </workout>
</workout_file>
